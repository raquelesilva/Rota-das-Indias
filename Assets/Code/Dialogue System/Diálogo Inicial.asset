      m_Calls: []
  onNodeEnterEvent: 
  onNodeExitEvent: 
  dialogueText: "Com a conquista de Ceuta, Portugal deu o seu primeiro passo para
    uma nova era. O que antes era uma guerra por territ\xF3rio transformou-se no
    in\xEDcio de um tempo de explora\xE7\xE3o e descoberta."
  nextNode: {fileID: 0}
