      m_Calls: []
  onNodeEnterEvent: 
  onNodeExitEvent: 
  dialogueText: "A entrada do Mediterr\xE2neo erguia-se agora sob as bandeiras portuguesas,
    e o olhar do reino voltava-se para o vasto oceano em dire\xE7\xE3o \xE0 promessa
    do desconhecido."
  nextNode: {fileID: 0}
